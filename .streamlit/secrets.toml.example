# Copia este archivo como .streamlit/secrets.toml y llena tus llaves.
# secrets.toml NO se sube a GitHub (está en .gitignore).
# Todas las llaves son opcionales: sin ellas la app usa fuentes de respaldo gratuitas.

# ── Asistente Calibra ──────────────────────────────────────────────────────────
# Gemini (Google AI Studio, gratis hasta los límites del plan free):
#   1. Ve a https://aistudio.google.com/apikey
#   2. Crea una llave y pégala aquí.
#   3. Límites del plan gratuito: ~1,500 req/día, ~1 millón de tokens/min (cambian; revísalos en tu cuenta).
#   Nota de privacidad: el texto de las preguntas generales se envía a Google. Sin datos de ventas ni de clientes.
[gemini]
api_key = ""
# model = "gemini-2.0-flash-exp"     # opcional: usa el modelo que prefieras del plan gratuito

# Groq (console.groq.com, gratis hasta los límites del plan free):
#   1. Ve a https://console.groq.com/keys
#   2. Crea una llave y pégala aquí.
#   3. Límites gratuitos: dependen del modelo; revísalos en la consola de Groq.
#   Nota de privacidad: el texto de las preguntas generales se envía a Groq.
[groq]
api_key = ""
# model = "llama-3.1-8b-instant"     # opcional

# ── Datos de mercado en vivo ────────────────────────────────────────────────────
# Banxico SIE (tipo de cambio FIX oficial):
#   Solicita un token gratuito en https://www.banxico.org.mx/SieAPIRest/service/v1/token
[banxico]
token = ""

# FRED (Federal Reserve Economic Data — datos históricos mensuales):
#   Llave gratuita en https://fred.stlouisfed.org/docs/api/api_key.html
[fred]
api_key = ""

# Alpha Vantage (datos históricos de metales, respaldo):
#   Llave gratuita en https://www.alphavantage.co/support/#api-key
[alphavantage]
api_key = ""
